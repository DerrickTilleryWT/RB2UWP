From fffc93a8896dc41c61168991c9ea91e18657fffc Mon Sep 17 00:00:00 2001
From: dooset22 <dooset22@gmail.com>
Date: Sun, 25 Oct 2026 21:48:32 -0400
Subject: [PATCH] UWP: replace spdlog's console default logger

spdlog's registry creates its default logger with the Windows console
color sink, which UWP builds leave out, so linking the app failed
(undefined wincolor_stdout_sink). Build spdlog with
SPDLOG_DISABLE_DEFAULT_LOGGER on UWP and install a default logger that
writes to the debugger until InitLogging replaces it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01T2Eqt3AmpbNRB9dC5uwqee
---
 src/core/logging.cpp      | 15 +++++++++++++++
 thirdparty/CMakeLists.txt |  4 ++++
 2 files changed, 19 insertions(+)

diff --git a/src/core/logging.cpp b/src/core/logging.cpp
index dd01b81..942b401 100644
--- a/src/core/logging.cpp
+++ b/src/core/logging.cpp
@@ -49,6 +49,21 @@ namespace {
 
     // Stored configuration
     LogConfig g_config;
+
+#if REX_PLATFORM_WINRT
+    // UWP builds compile spdlog with SPDLOG_DISABLE_DEFAULT_LOGGER: its
+    // built-in default logger writes to a console, which UWP apps don't have
+    // (and the console sink isn't built). Give spdlog a default logger that
+    // writes to an attached debugger until InitLogging replaces it, so direct
+    // spdlog:: calls never find it missing.
+    struct UwpDefaultLogger {
+        UwpDefaultLogger() {
+            spdlog::set_default_logger(std::make_shared<spdlog::logger>(
+                "", std::make_shared<spdlog::sinks::msvc_sink_mt>()));
+        }
+    };
+    UwpDefaultLogger g_uwp_default_logger;
+#endif
 }
 
 void InitLogging(const LogConfig& config) {
diff --git a/thirdparty/CMakeLists.txt b/thirdparty/CMakeLists.txt
index 0338ce5..0c4027a 100644
--- a/thirdparty/CMakeLists.txt
+++ b/thirdparty/CMakeLists.txt
@@ -152,6 +152,10 @@ if(REXGLUE_UWP)
     list(FILTER _spdlog_sources EXCLUDE REGEX "color_sinks\\.cpp$")
     set_property(TARGET spdlog PROPERTY SOURCES ${_spdlog_sources})
     unset(_spdlog_sources)
+    # spdlog's registry would otherwise create its default logger with a
+    # console color sink. rex logging installs a debugger-output default
+    # logger instead (src/core/logging.cpp).
+    target_compile_definitions(spdlog PRIVATE SPDLOG_DISABLE_DEFAULT_LOGGER)
 endif()
 
 #=============================================================================
