diff --git a/src/core/exception_handler_win.cpp b/src/core/exception_handler_win.cpp
index f259f8d..e59620e 100644
--- a/src/core/exception_handler_win.cpp
+++ b/src/core/exception_handler_win.cpp
@@ -17,6 +17,78 @@
 #include <rex/math.h>
 #include <rex/platform/win.h>
 
+#if REX_PLATFORM_WINRT
+#include <rex/platform/uwp.h>
+#endif
+
+namespace {
+
+// Vectored exception handling is what lets the runtime trap guest MMIO and
+// memory-watch accesses. On UWP the functions exist in the OS (including on
+// Xbox) but aren't exposed by the app API partition, so they're looked up at
+// runtime there.
+using AddVectoredHandlerFn = PVOID(WINAPI*)(ULONG first,
+                                            PVECTORED_EXCEPTION_HANDLER handler);
+using RemoveVectoredHandlerFn = ULONG(WINAPI*)(PVOID handle);
+
+PVOID AddVectoredExceptionHandlerCompat(ULONG first,
+                                        PVECTORED_EXCEPTION_HANDLER handler) {
+#if REX_PLATFORM_WINRT
+  static const auto add = [] {
+    auto fn = rex::platform::uwp::GetSystemProc<AddVectoredHandlerFn>(
+        "AddVectoredExceptionHandler");
+    if (!fn) {
+      fn = rex::platform::uwp::GetSystemProc<AddVectoredHandlerFn>(
+          "RtlAddVectoredExceptionHandler");
+    }
+    return fn;
+  }();
+  return add ? add(first, handler) : nullptr;
+#else
+  return AddVectoredExceptionHandler(first, handler);
+#endif
+}
+
+void RemoveVectoredExceptionHandlerCompat(PVOID handle) {
+#if REX_PLATFORM_WINRT
+  static const auto remove = [] {
+    auto fn = rex::platform::uwp::GetSystemProc<RemoveVectoredHandlerFn>(
+        "RemoveVectoredExceptionHandler");
+    if (!fn) {
+      fn = rex::platform::uwp::GetSystemProc<RemoveVectoredHandlerFn>(
+          "RtlRemoveVectoredExceptionHandler");
+    }
+    return fn;
+  }();
+  if (remove) {
+    remove(handle);
+  }
+#else
+  RemoveVectoredExceptionHandler(handle);
+#endif
+}
+
+void RemoveVectoredContinueHandlerCompat(PVOID handle) {
+#if REX_PLATFORM_WINRT
+  static const auto remove = [] {
+    auto fn = rex::platform::uwp::GetSystemProc<RemoveVectoredHandlerFn>(
+        "RemoveVectoredContinueHandler");
+    if (!fn) {
+      fn = rex::platform::uwp::GetSystemProc<RemoveVectoredHandlerFn>(
+          "RtlRemoveVectoredContinueHandler");
+    }
+    return fn;
+  }();
+  if (remove) {
+    remove(handle);
+  }
+#else
+  RemoveVectoredContinueHandler(handle);
+#endif
+}
+
+}  // namespace
+
 namespace rex::arch {
 
 // Handle of the added VectoredExceptionHandler.
