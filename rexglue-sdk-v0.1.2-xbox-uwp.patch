-    sdl2
 )
 
+# SDL2 (audio and controllers) isn't used by UWP builds - XAudio2 and
+# Windows.Gaming.Input are used instead.
+if(NOT REXGLUE_UWP)
+    list(APPEND REQUIRED_SUBMODULES sdl2)
+endif()
+
 if(REXGLUE_USE_VULKAN)
     list(APPEND REQUIRED_SUBMODULES
         volk vulkan-headers vulkan-memory-allocator
@@ -119,6 +124,11 @@ target_compile_options(disasm PRIVATE -w)
 set(FMT_DOC OFF CACHE BOOL "" FORCE)
 set(FMT_TEST OFF CACHE BOOL "" FORCE)
 set(FMT_INSTALL ON CACHE BOOL "" FORCE)
