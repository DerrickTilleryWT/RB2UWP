diff --git a/CMakeLists.txt b/CMakeLists.txt
index 65eb5db..a1615d2 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -13,6 +13,12 @@ project(ReXGlue
 #==========================================================
 option(REXGLUE_BUILD_TESTS       "Build PPC instruction and unit tests" OFF)
 option(REXGLUE_ENABLE_SANITIZERS "Enable UndefinedBehaviorSanitizer" OFF)
+# UWP (Universal Windows Platform) build, for example for Xbox Developer Mode.
+# Uses CoreWindow, Windows.Gaming.Input and XAudio2 instead of Win32 windows
+# and SDL. Configure from a Visual Studio "x64 Native Tools" prompt set up for
+# UWP (vcvarsall.bat x64 uwp) so the app-container CRT and WindowsApp.lib are
+# used. See docs/UWP.md.
+option(REXGLUE_UWP "Build for UWP (Xbox Developer Mode)" OFF)
 
 # Graphics backend selection
 # D3D12: Windows only, ON by default.
@@ -25,6 +31,15 @@ else()
     option(REXGLUE_USE_VULKAN "Enable Vulkan graphics backend" ON)
 endif()
 
+if(REXGLUE_UWP)
+    if(NOT WIN32)
+        message(FATAL_ERROR "REXGLUE_UWP requires a Windows target")
+    endif()
+    # Xbox exposes Direct3D 12 (feature level 11_0) to UWP games, not Vulkan.
+    set(REXGLUE_USE_D3D12 ON CACHE BOOL "" FORCE)
+    set(REXGLUE_USE_VULKAN OFF CACHE BOOL "" FORCE)
+endif()
+
 if(NOT REXGLUE_USE_D3D12 AND NOT REXGLUE_USE_VULKAN)
     message(FATAL_ERROR "At least one graphics backend must be enabled (REXGLUE_USE_D3D12 or REXGLUE_USE_VULKAN)")
 endif()
@@ -74,7 +89,22 @@ add_compile_options(
 )
 
 # Platform detection
-if(WIN32)
+if(WIN32 AND REXGLUE_UWP)
+    set(REX_PLATFORM "uwp-amd64")
+    add_compile_definitions(REX_PLATFORM_WINDOWS=1)
+    # Restrict the Windows headers to the APIs available to UWP apps; the code
+    # checks REX_PLATFORM_WINRT (derived from this in rex/platform.h).
+    add_compile_definitions(WINAPI_FAMILY=WINAPI_FAMILY_APP)
+    # Also set by rex/platform.h from WINAPI_FAMILY; defined here too so it's
+    # correct regardless of include order.
+    add_compile_definitions(REX_PLATFORM_WINRT=1)
+    # Windows 10 2004+ API level (VirtualAlloc2FromApp and
+    # MapViewOfFile3FromApp need 1803+); current Xbox system software is newer.
+    add_compile_definitions(_WIN32_WINNT=0x0A00 NTDDI_VERSION=0x0A000008)
+    # Shared toolchain settings for UWP (C runtime, system libraries), also
+    # used by projects that consume the installed SDK.
+    include(${CMAKE_CURRENT_SOURCE_DIR}/cmake/uwp/rexglue_uwp_toolchain.cmake)
+elseif(WIN32)
     set(REX_PLATFORM "win-amd64")
     add_compile_definitions(REX_PLATFORM_WINDOWS=1)
 elseif(UNIX AND NOT APPLE)
@@ -120,8 +150,12 @@ add_subdirectory(src/audio)
 add_subdirectory(src/graphics)
 add_subdirectory(src/kernel)
 add_subdirectory(src/runtime)
-add_subdirectory(src/codegen)    
-add_subdirectory(src/rexglue)
+if(NOT REXGLUE_UWP)
+    # The recompiler and its CLI are desktop tools - run codegen with a
+    # regular Windows or Linux build of the SDK, then build the game for UWP.
+    add_subdirectory(src/codegen)
+    add_subdirectory(src/rexglue)
+endif()
 
 # Add tests subdirectory if tests are enabled
 if(REXGLUE_BUILD_TESTS)
@@ -138,6 +172,7 @@ message(STATUS "  Configurations: ${CMAKE_CONFIGURATION_TYPES}")
 message(STATUS "  Output Dir: ${CMAKE_RUNTIME_OUTPUT_DIRECTORY}")
 message(STATUS "  C++ Standard: C++${CMAKE_CXX_STANDARD}")
 message(STATUS "  Graphics: D3D12=${REXGLUE_USE_D3D12} Vulkan=${REXGLUE_USE_VULKAN}")
+message(STATUS "  UWP: ${REXGLUE_UWP}")
 message(STATUS "===========================================")
 
 # SDK install/export rules
