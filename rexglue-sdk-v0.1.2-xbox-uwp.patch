+/**
+ * @file        ui/window_uwp.cpp
+ *
+ * @brief       Window backed by the UWP CoreWindow (Xbox Developer Mode).
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/ui/window_uwp.h>
+
+#if REX_PLATFORM_WINRT
+
+#include <chrono>
+#include <cmath>
+
+#include <rex/logging.h>
+#include <rex/ui/surface_winrt.h>
+#include <rex/ui/windowed_app_context_uwp.h>
+
+#include "ui/winrt_core_window_util.h"
+
+namespace rex {
+namespace ui {
+
+namespace {
+// The CoreWindow can't be resized by the user on Xbox, so the size is only
+// re-checked occasionally (for instance after a display mode change).
+constexpr auto kSizePollInterval = std::chrono::milliseconds(1000);
+thread_local std::chrono::steady_clock::time_point last_size_poll_;
+}  // namespace
+
+std::unique_ptr<Window> Window::Create(WindowedAppContext& app_context,
+                                       const std::string_view title,
+                                       uint32_t desired_logical_width,
+                                       uint32_t desired_logical_height) {
+  return std::make_unique<UWPWindow>(app_context, title, desired_logical_width,
+                                     desired_logical_height);
+}
+
+std::unique_ptr<MenuItem> MenuItem::Create(Type type, const std::string& text,
+                                           const std::string& hotkey,
+                                           std::function<void()> callback) {
+  return std::make_unique<UWPMenuItem>(type, text, hotkey, std::move(callback));
+}
+
+UWPWindow::UWPWindow(WindowedAppContext& app_context,
+                     const std::string_view title,
+                     uint32_t desired_logical_width,
+                     uint32_t desired_logical_height)
+    : Window(app_context, title, desired_logical_width,
+             desired_logical_height) {
+  // The CoreWindow is always fullscreen.
+  OnDesiredFullscreenUpdate(true);
+}
+
+UWPWindow::~UWPWindow() {
+  EnterDestructor();
+  if (uwp_app_context().window() == this) {
+    uwp_app_context().SetWindow(nullptr);
+  }
+}
+
+UWPWindowedAppContext& UWPWindow::uwp_app_context() const {
+  return static_cast<UWPWindowedAppContext&>(app_context());
+}
+
+bool UWPWindow::OpenImpl() {
+  UWPWindowedAppContext& context = uwp_app_context();
+  if (context.window() && context.window() != this) {
+    REXLOG_ERROR("UWPWindow: only one window is supported on UWP");
+    return false;
+  }
+  context.SetWindow(this);
+  is_open_ = true;
+
+  // Report the initial state; listener notification is done by Window::Open.
+  WindowDestructionReceiver destruction_receiver(this);
+  uint32_t width = 0, height = 0;
+  if (winrt_util::GetCoreWindowPhysicalSize(context.core_window(), width,
+                                            height, scale_)) {
+    last_physical_width_ = width;
+    last_physical_height_ = height;
+    OnDesiredLogicalSizeUpdate(SizeToLogical(width), SizeToLogical(height));
+    OnActualSizeUpdate(width, height, destruction_receiver);
+    if (destruction_receiver.IsWindowDestroyed()) {
+      return true;
+    }
+  }
+  last_size_poll_ = std::chrono::steady_clock::now();
+  OnFocusUpdate(true, destruction_receiver);
+  return true;
+}
+
+void UWPWindow::RequestCloseImpl() {
+  // There's no window to destroy - the CoreWindow lives as long as the app.
+  // Run the closing sequence (OnBeforeClose notifies the listeners' OnClosing)
+  // so the app shuts down like when a desktop window is closed.
+  WindowDestructionReceiver destruction_receiver(this);
+  OnBeforeClose(destruction_receiver);
+  if (destruction_receiver.IsWindowDestroyed()) {
+    return;
+  }
+  is_open_ = false;
+  if (uwp_app_context().window() == this) {
+    uwp_app_context().SetWindow(nullptr);
+  }
+  OnAfterClose();
+}
+
+uint32_t UWPWindow::GetLatestDpiImpl() const {
+  return uint32_t(std::lround(double(GetMediumDpi()) * scale_));
+}
+
+std::unique_ptr<Surface> UWPWindow::CreateSurfaceImpl(
+    Surface::TypeFlags allowed_types) {
+  if (!(allowed_types & Surface::kTypeFlag_WinRTCoreWindow)) {
+    return nullptr;
+  }
+  IUnknown* core_window = uwp_app_context().core_window();
+  if (!core_window) {
+    return nullptr;
+  }
+  return std::make_unique<WinRTCoreWindowSurface>(core_window);
+}
+
+void UWPWindow::RequestPaintImpl() {
+  // May be called from any thread - coalesce and wake the UI loop.
+  if (!paint_pending_.exchange(true, std::memory_order_acq_rel)) {
+    uwp_app_context().WakeUILoop();
+  }
+}
+
+void UWPWindow::UpdateSize(WindowDestructionReceiver& destruction_receiver) {
+  uint32_t width = 0, height = 0;
+  double scale = 1.0;
+  if (!winrt_util::GetCoreWindowPhysicalSize(uwp_app_context().core_window(),
+                                             width, height, scale)) {
+    return;
+  }
+  bool dpi_changed = scale != scale_;
+  scale_ = scale;
+  if (dpi_changed) {
+    UISetupEvent e(this);
+    OnDpiChanged(e, destruction_receiver);
+    if (destruction_receiver.IsWindowDestroyedOrClosed()) {
+      return;
+    }
+  }
+  if (width != last_physical_width_ || height != last_physical_height_) {
+    last_physical_width_ = width;
+    last_physical_height_ = height;
+    OnDesiredLogicalSizeUpdate(SizeToLogical(width), SizeToLogical(height));
+    OnActualSizeUpdate(width, height, destruction_receiver);
+  }
+}
+
+void UWPWindow::HandleUILoopIteration() {
+  if (!is_open_) {
+    return;
+  }
+  WindowDestructionReceiver destruction_receiver(this);
+  auto now = std::chrono::steady_clock::now();
+  if (now - last_size_poll_ >= kSizePollInterval) {
+    last_size_poll_ = now;
+    UpdateSize(destruction_receiver);
+    if (destruction_receiver.IsWindowDestroyedOrClosed()) {
+      return;
+    }
+  }
+  if (paint_pending_.exchange(false, std::memory_order_acq_rel)) {
+    OnPaint();
+  }
+}
+
+}  // namespace ui
+}  // namespace rex
+
+#endif  // REX_PLATFORM_WINRT
diff --git a/src/ui/windowed_app_context_uwp.cpp b/src/ui/windowed_app_context_uwp.cpp
new file mode 100644
index 0000000..ddd7311
--- /dev/null
+++ b/src/ui/windowed_app_context_uwp.cpp
@@ -0,0 +1,123 @@
+/**
+ * @file        ui/windowed_app_context_uwp.cpp
+ *
+ * @brief       UI loop context for UWP builds (Xbox Developer Mode).
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/ui/windowed_app_context_uwp.h>
+
+#if REX_PLATFORM_WINRT
+
+#include <cstdlib>
+
+#include <wrl/client.h>
+
+#include <windows.ui.core.h>
+
+#include <rex/ui/window_uwp.h>
+
+namespace rex {
+namespace ui {
+
+namespace core = ABI::Windows::UI::Core;
+using Microsoft::WRL::ComPtr;
+
+namespace {
+// The loop sleeps on an event that pending functions and paint requests
+// signal, and also wakes up at this interval to process CoreWindow events,
+// which don't signal that event.
+constexpr DWORD kCoreEventPollIntervalMs = 4;
+}  // namespace
+
+UWPWindowedAppContext::UWPWindowedAppContext(IUnknown* core_window)
+    : core_window_(core_window) {
+  if (core_window_) {
+    core_window_->AddRef();
+  }
+}
+
+UWPWindowedAppContext::~UWPWindowedAppContext() {
+  // Execute leftover pending functions before the loop machinery goes away,
+  // per the WindowedAppContext shutdown contract. Nothing virtual may be called
+  // from here, and ExecutePendingFunctionsFromUIThread isn't virtual.
+  ExecutePendingFunctionsFromUIThread();
+  if (wake_event_) {
+    CloseHandle(static_cast<HANDLE>(wake_event_));
+    wake_event_ = nullptr;
+  }
+  if (dispatcher_) {
+    dispatcher_->Release();
+    dispatcher_ = nullptr;
+  }
+  if (core_window_) {
+    core_window_->Release();
+    core_window_ = nullptr;
+  }
+}
+
+bool UWPWindowedAppContext::Initialize() {
+  if (!core_window_) {
+    return false;
+  }
+  ComPtr<core::ICoreWindow> window;
+  if (FAILED(core_window_->QueryInterface(IID_PPV_ARGS(window.GetAddressOf())))) {
+    return false;
+  }
+  ComPtr<core::ICoreDispatcher> dispatcher;
+  if (FAILED(window->get_Dispatcher(dispatcher.GetAddressOf())) ||
+      !dispatcher) {
+    return false;
+  }
+  dispatcher_ = dispatcher.Detach();
+
+  wake_event_ = CreateEventExW(nullptr, nullptr, 0, EVENT_ALL_ACCESS);
+  return wake_event_ != nullptr;
+}
+
+void UWPWindowedAppContext::WakeUILoop() {
+  if (wake_event_) {
+    SetEvent(static_cast<HANDLE>(wake_event_));
+  }
+}
+
+void UWPWindowedAppContext::NotifyUILoopOfPendingFunctions() { WakeUILoop(); }
+
+void UWPWindowedAppContext::PlatformQuitFromUIThread() {
+  // RunMainMessageLoop checks HasQuitFromUIThread after every wake-up.
+  WakeUILoop();
+}
+
+int UWPWindowedAppContext::RunMainMessageLoop() {
+  auto* dispatcher = static_cast<core::ICoreDispatcher*>(dispatcher_);
+  while (!HasQuitFromUIThread()) {
+    // Window activation, visibility, the system's suspend requests and so on.
+    if (dispatcher &&
+        FAILED(dispatcher->ProcessEvents(
+            core::CoreProcessEventsOption_ProcessAllIfPresent))) {
+      // The window is gone - nothing more can be shown.
+      QuitFromUIThread();
+      break;
+    }
+    ExecutePendingFunctionsFromUIThread();
+    if (HasQuitFromUIThread()) {
+      break;
+    }
+    if (window_) {
+      window_->HandleUILoopIteration();
+    }
+    if (HasQuitFromUIThread()) {
+      break;
+    }
+    WaitForSingleObjectEx(static_cast<HANDLE>(wake_event_),
+                          kCoreEventPollIntervalMs, FALSE);
+  }
+  return EXIT_SUCCESS;
+}
+
+}  // namespace ui
+}  // namespace rex
+
+#endif  // REX_PLATFORM_WINRT
diff --git a/src/ui/windowed_app_main_uwp.cpp b/src/ui/windowed_app_main_uwp.cpp
new file mode 100644
index 0000000..4d58526
--- /dev/null
+++ b/src/ui/windowed_app_main_uwp.cpp
@@ -0,0 +1,281 @@
+/**
+ * @file        ui/windowed_app_main_uwp.cpp
+ *
+ * @brief       Entry point for windowed apps built as UWP apps (Xbox Developer
+ *              Mode). Compiled into the app, like windowed_app_main_win.cpp.
+ *
+ *              UWP apps get no command line, so arguments come from optional
+ *              files in the app's LocalState folder (reachable from the Xbox
+ *              Device Portal file explorer):
+ *                - args.txt: one argument per line, like a command line, for
+ *                  example "--log_verbose=true" or a positional argument.
+ *                - config.toml: cvar values, loaded with cvar::LoadConfig.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_WINRT
+
+#include <atomic>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <map>
+#include <memory>
+#include <string>
+#include <system_error>
+#include <vector>
+
+#include <inspectable.h>
+#include <roapi.h>
+#include <winstring.h>
+#include <wrl/client.h>
+
+#include <windows.applicationmodel.core.h>
+#include <windows.ui.core.h>
+
+#include <rex/cvar.h>
+#include <rex/platform/uwp.h>
+#include <rex/ui/windowed_app.h>
+#include <rex/ui/windowed_app_context_uwp.h>
+
+namespace {
+
+namespace app_core = ABI::Windows::ApplicationModel::Core;
+namespace ui_core = ABI::Windows::UI::Core;
+using Microsoft::WRL::ComPtr;
+
+// {94EA2B94-E9CC-49E0-C0FF-EE64CA8F5B90}
+constexpr IID kIID_IAgileObject = {
+    0x94ea2b94, 0xe9cc, 0x49e0, {0xc0, 0xff, 0xee, 0x64, 0xca, 0x8f, 0x5b, 0x90}};
+
+std::vector<std::string> ReadArgumentsFile(const std::filesystem::path& path) {
+  std::vector<std::string> args;
+  std::error_code error;
+  if (path.empty() || !std::filesystem::exists(path, error)) {
+    return args;
+  }
+  std::ifstream file(path);
+  std::string line;
+  while (std::getline(file, line)) {
+    // Trim whitespace (including a CR from Windows line endings).
+    auto begin = line.find_first_not_of(" \t\r\n");
+    if (begin == std::string::npos) {
+      continue;
+    }
+    auto end = line.find_last_not_of(" \t\r\n");
+    line = line.substr(begin, end - begin + 1);
+    if (line.empty() || line[0] == '#') {
+      continue;
+    }
+    args.push_back(std::move(line));
+  }
+  return args;
+}
+
+int RunWindowedApp(IUnknown* core_window) {
+  const std::filesystem::path& local_folder =
+      rex::platform::uwp::GetLocalFolder();
+
+  // Build argv: the executable name, then the arguments from args.txt.
+  std::vector<std::string> utf8_args;
+  utf8_args.emplace_back("rexglue");
+  for (auto& arg : ReadArgumentsFile(local_folder.empty()
+                                         ? std::filesystem::path()
+                                         : local_folder / "args.txt")) {
+    utf8_args.push_back(std::move(arg));
+  }
+  std::vector<char*> argv_ptrs;
+  argv_ptrs.reserve(utf8_args.size());
+  for (auto& arg : utf8_args) {
+    argv_ptrs.push_back(arg.data());
+  }
+  auto remaining =
+      rex::cvar::Init(static_cast<int>(argv_ptrs.size()), argv_ptrs.data());
+  if (!local_folder.empty()) {
+    std::error_code error;
+    std::filesystem::path config_path = local_folder / "config.toml";
+    if (std::filesystem::exists(config_path, error)) {
+      rex::cvar::LoadConfig(config_path);
+    }
+  }
+  rex::cvar::ApplyEnvironment();
+
+  int result;
+  {
+    rex::ui::UWPWindowedAppContext app_context(core_window);
+    if (!app_context.Initialize()) {
+      return EXIT_FAILURE;
+    }
+
+    std::unique_ptr<rex::ui::WindowedApp> app =
+        rex::ui::GetWindowedAppCreator()(app_context);
+
+    // Match remaining positional args to the app's expected options.
+    const auto& option_names = app->GetPositionalOptions();
+    std::map<std::string, std::string> parsed;
+    size_t count = std::min(remaining.size(), option_names.size());
+    for (size_t i = 0; i < count; ++i) {
+      parsed[option_names[i]] = remaining[i];
+    }
+    app->SetParsedArguments(std::move(parsed));
+
+    result =
+        app->OnInitialize() ? app_context.RunMainMessageLoop() : EXIT_FAILURE;
+
+    app->InvokeOnDestroy();
+  }
+  return result;
+}
+
+// Minimal IInspectable implementation for the framework view objects. They
+// are agile, so the system can call them from any thread.
+template <typename Interface>
+class InspectableBase : public Interface {
+ public:
+  virtual ~InspectableBase() = default;
+
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid,
+                                           void** object) override {
+    if (!object) {
+      return E_POINTER;
+    }
+    if (IsEqualIID(riid, __uuidof(IUnknown)) ||
+        IsEqualIID(riid, __uuidof(IInspectable)) ||
+        IsEqualIID(riid, __uuidof(Interface)) ||
+        IsEqualIID(riid, kIID_IAgileObject)) {
+      *object = static_cast<Interface*>(this);
+      AddRef();
+      return S_OK;
+    }
+    *object = nullptr;
+    return E_NOINTERFACE;
+  }
+  ULONG STDMETHODCALLTYPE AddRef() override { return ++reference_count_; }
+  ULONG STDMETHODCALLTYPE Release() override {
+    ULONG count = --reference_count_;
+    if (!count) {
+      delete this;
+    }
+    return count;
+  }
+  HRESULT STDMETHODCALLTYPE GetIids(ULONG* iid_count, IID** iids) override {
+    if (!iid_count || !iids) {
+      return E_POINTER;
+    }
+    *iid_count = 0;
+    *iids = nullptr;
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE GetRuntimeClassName(HSTRING* class_name) override {
+    if (!class_name) {
+      return E_POINTER;
+    }
+    *class_name = nullptr;
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE GetTrustLevel(TrustLevel* trust_level) override {
+    if (!trust_level) {
+      return E_POINTER;
+    }
+    *trust_level = BaseTrust;
+    return S_OK;
+  }
+
+ private:
+  std::atomic<ULONG> reference_count_{1};
+};
+
+class FrameworkView final : public InspectableBase<app_core::IFrameworkView> {
+ public:
+  HRESULT STDMETHODCALLTYPE
+  Initialize(app_core::ICoreApplicationView* application_view) override {
+    (void)application_view;
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE SetWindow(ui_core::ICoreWindow* window) override {
+    window_ = window;
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE Load(HSTRING entry_point) override {
+    (void)entry_point;
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE Run() override {
+    if (!window_) {
+      return E_UNEXPECTED;
+    }
+    // Show the window (dismisses the splash screen), then run the app on this
+    // thread, which is the CoreWindow's thread.
+    window_->Activate();
+    exit_code_ = RunWindowedApp(window_.Get());
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE Uninitialize() override {
+    window_.Reset();
+    return S_OK;
+  }
+
+  static int exit_code() { return exit_code_; }
+
+ private:
+  ComPtr<ui_core::ICoreWindow> window_;
+  static inline int exit_code_ = EXIT_SUCCESS;
+};
+
+class FrameworkViewSource final
+    : public InspectableBase<app_core::IFrameworkViewSource> {
+ public:
+  HRESULT STDMETHODCALLTYPE
+  CreateView(app_core::IFrameworkView** view_provider) override {
+    if (!view_provider) {
+      return E_POINTER;
+    }
+    *view_provider = new FrameworkView();
+    return S_OK;
+  }
+};
+
+}  // namespace
+
+int WINAPI wWinMain(HINSTANCE hinstance, HINSTANCE hinstance_prev,
+                    LPWSTR command_line, int show_cmd) {
+  (void)hinstance;
+  (void)hinstance_prev;
+  (void)command_line;
+  (void)show_cmd;
+
+  if (FAILED(RoInitialize(RO_INIT_MULTITHREADED))) {
+    return EXIT_FAILURE;
+  }
+
+  static const wchar_t kClassName[] =
+      L"Windows.ApplicationModel.Core.CoreApplication";
+  HSTRING_HEADER class_name_header;
+  HSTRING class_name = nullptr;
+  ComPtr<app_core::ICoreApplication> core_application;
+  if (FAILED(WindowsCreateStringReference(
+          kClassName, UINT32(std::size(kClassName) - 1), &class_name_header,
+          &class_name)) ||
+      FAILED(RoGetActivationFactory(
+          class_name, IID_PPV_ARGS(core_application.GetAddressOf())))) {
+    RoUninitialize();
+    return EXIT_FAILURE;
+  }
+
+  ComPtr<app_core::IFrameworkViewSource> view_source;
+  view_source.Attach(new FrameworkViewSource());
+  // Returns when the view's Run returns (the app quit) - the process should
+  // then exit.
+  HRESULT run_result = core_application->Run(view_source.Get());
+  view_source.Reset();
+  core_application.Reset();
+  RoUninitialize();
+  return SUCCEEDED(run_result) ? FrameworkView::exit_code() : EXIT_FAILURE;
+}
+
+#endif  // REX_PLATFORM_WINRT
diff --git a/src/ui/winrt_core_window_util.cpp b/src/ui/winrt_core_window_util.cpp
new file mode 100644
index 0000000..cae366a
--- /dev/null
+++ b/src/ui/winrt_core_window_util.cpp
@@ -0,0 +1,93 @@
+/**
+ * @file        ui/winrt_core_window_util.cpp
+ *
+ * @brief       CoreWindow helpers for UWP builds. See winrt_core_window_util.h.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include "ui/winrt_core_window_util.h"
+
+#if REX_PLATFORM_WINRT
+
+#include <cmath>
+#include <iterator>
+
+#include <roapi.h>
+#include <winstring.h>
+#include <wrl/client.h>
+
+#include <windows.graphics.display.h>
+#include <windows.ui.core.h>
+
+namespace rex::ui::winrt_util {
+
+using Microsoft::WRL::ComPtr;
+
+namespace {
+
+// Raw physical pixels per view (device-independent) pixel of the current
+// view's display, or 1 if unavailable.
+double GetCurrentViewScale() {
+  namespace display = ABI::Windows::Graphics::Display;
+  static const wchar_t kClassName[] =
+      L"Windows.Graphics.Display.DisplayInformation";
+  HSTRING_HEADER class_name_header;
+  HSTRING class_name = nullptr;
+  if (FAILED(WindowsCreateStringReference(
+          kClassName, UINT32(std::size(kClassName) - 1), &class_name_header,
+          &class_name))) {
+    return 1.0;
+  }
+  ComPtr<display::IDisplayInformationStatics> statics;
+  if (FAILED(RoGetActivationFactory(class_name,
+                                    IID_PPV_ARGS(statics.GetAddressOf())))) {
+    return 1.0;
+  }
+  ComPtr<display::IDisplayInformation> info;
+  if (FAILED(statics->GetForCurrentView(info.GetAddressOf())) || !info) {
+    return 1.0;
+  }
+  ComPtr<display::IDisplayInformation2> info2;
+  if (SUCCEEDED(info.As(&info2))) {
+    DOUBLE raw_pixels_per_view_pixel = 0.0;
+    if (SUCCEEDED(info2->get_RawPixelsPerViewPixel(&raw_pixels_per_view_pixel)) &&
+        raw_pixels_per_view_pixel > 0.0) {
+      return raw_pixels_per_view_pixel;
+    }
+  }
+  FLOAT logical_dpi = 0.0f;
+  if (SUCCEEDED(info->get_LogicalDpi(&logical_dpi)) && logical_dpi > 0.0f) {
+    return double(logical_dpi) / 96.0;
+  }
+  return 1.0;
+}
+
+}  // namespace
+
+bool GetCoreWindowPhysicalSize(IUnknown* core_window, uint32_t& width_out,
+                               uint32_t& height_out, double& scale_out) {
+  width_out = 0;
+  height_out = 0;
+  scale_out = 1.0;
+  if (!core_window) {
+    return false;
+  }
+  ComPtr<ABI::Windows::UI::Core::ICoreWindow> window;
+  if (FAILED(core_window->QueryInterface(IID_PPV_ARGS(window.GetAddressOf())))) {
+    return false;
+  }
+  ABI::Windows::Foundation::Rect bounds = {};
+  if (FAILED(window->get_Bounds(&bounds))) {
+    return false;
+  }
+  scale_out = GetCurrentViewScale();
+  width_out = uint32_t(std::lround(double(bounds.Width) * scale_out));
+  height_out = uint32_t(std::lround(double(bounds.Height) * scale_out));
+  return width_out && height_out;
+}
+
+}  // namespace rex::ui::winrt_util
+
+#endif  // REX_PLATFORM_WINRT
diff --git a/src/ui/winrt_core_window_util.h b/src/ui/winrt_core_window_util.h
new file mode 100644
index 0000000..dc93fe0
--- /dev/null
+++ b/src/ui/winrt_core_window_util.h
@@ -0,0 +1,32 @@
+/**
+ * @file        ui/winrt_core_window_util.h
+ *
+ * @brief       CoreWindow helpers shared by the UWP window, surface and app
+ *              context. Private to rexui.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstdint>
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_WINRT
+
+#include <unknwn.h>
+
+namespace rex::ui::winrt_util {
+
+// Gets the size of the CoreWindow in physical pixels. CoreWindow bounds are in
+// device-independent pixels, so they're scaled by the display's raw pixels per
+// view pixel. Must be called on the window's (UI) thread. scale_out receives
+// the physical pixels per DIP.
+bool GetCoreWindowPhysicalSize(IUnknown* core_window, uint32_t& width_out,
+                               uint32_t& height_out, double& scale_out);
+
+}  // namespace rex::ui::winrt_util
+
+#endif  // REX_PLATFORM_WINRT
