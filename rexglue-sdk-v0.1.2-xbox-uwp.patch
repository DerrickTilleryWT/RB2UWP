+
+namespace rex::ui {
+
+WinRTCoreWindowSurface::WinRTCoreWindowSurface(IUnknown* core_window)
+    : core_window_(core_window) {
+  if (core_window_) {
+    core_window_->AddRef();
+  }
+}
+
+WinRTCoreWindowSurface::~WinRTCoreWindowSurface() {
+  if (core_window_) {
+    core_window_->Release();
+  }
+}
+
+bool WinRTCoreWindowSurface::GetSizeImpl(uint32_t& width_out,
+                                         uint32_t& height_out) const {
+  double scale;
+  return winrt_util::GetCoreWindowPhysicalSize(core_window_, width_out,
+                                               height_out, scale);
+}
+
+}  // namespace rex::ui
