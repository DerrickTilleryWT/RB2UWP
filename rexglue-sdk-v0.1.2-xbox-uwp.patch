diff --git a/cmake/rexglueConfig.cmake.in b/cmake/rexglueConfig.cmake.in
index 1d0fc41..cc7f29d 100644
--- a/cmake/rexglueConfig.cmake.in
+++ b/cmake/rexglueConfig.cmake.in
@@ -3,6 +3,9 @@
 # SDK share directory (entry point sources, etc.)
 set(REXGLUE_SHARE_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/rexglue")
 
+# Whether this SDK was built for UWP (Xbox Developer Mode).
+set(REXGLUE_UWP @REXGLUE_UWP@)
+
 include(CMakeFindDependencyMacro)
 
 # Required dependencies
@@ -10,7 +13,9 @@ find_dependency(fmt CONFIG)
 find_dependency(spdlog CONFIG)
 find_dependency(Snappy CONFIG)
 find_dependency(utf8cpp CONFIG)
-find_dependency(SDL2 CONFIG)
+if(NOT REXGLUE_UWP)
+    find_dependency(SDL2 CONFIG)
+endif()
 
 # Vulkan dependencies
 set(REXGLUE_USE_VULKAN @REXGLUE_USE_VULKAN@)
@@ -23,4 +28,16 @@ endif()
 # Include the generated targets
 include("${CMAKE_CURRENT_LIST_DIR}/rexglueTargets.cmake")
 
+if(REXGLUE_UWP)
+    # Compile definitions consumers need so their code sees the same Windows
+    # API partition as the SDK.
+    add_compile_definitions(
+        WINAPI_FAMILY=WINAPI_FAMILY_APP
+        REX_PLATFORM_WINRT=1
+        _WIN32_WINNT=0x0A00
+        NTDDI_VERSION=0x0A000008
+    )
+    include("${REXGLUE_SHARE_DIR}/uwp/rexglue_uwp.cmake")
+endif()
+
 check_required_components(rexglue)
diff --git a/cmake/rexglue_install.cmake b/cmake/rexglue_install.cmake
index 1d7ce23..be5a39e 100644
--- a/cmake/rexglue_install.cmake
+++ b/cmake/rexglue_install.cmake
@@ -9,21 +9,26 @@ set_target_properties(rexaudio PROPERTIES EXPORT_NAME audio)
 set_target_properties(rexgraphics PROPERTIES EXPORT_NAME graphics)
 set_target_properties(rexkernel PROPERTIES EXPORT_NAME kernel)
 set_target_properties(rexruntime PROPERTIES EXPORT_NAME runtime)
-set_target_properties(rexcodegen PROPERTIES EXPORT_NAME codegen)
+if(TARGET rexcodegen)
+    set_target_properties(rexcodegen PROPERTIES EXPORT_NAME codegen)
+endif()
 
 # Build install target list dynamically based on backend options
 set(REXGLUE_INSTALL_TARGETS
     # ReX SDK libraries
     rexcore rexfilesystem rexui rexinput
-    rexaudio rexgraphics rexkernel rexruntime rexcodegen
+    rexaudio rexgraphics rexkernel rexruntime
     # Vendored thirdparty libraries (required by SDK)
     disruptorplus renderdoc simde tomlplusplus  # INTERFACE (header-only)
     aes128 mspack disasm xxhash imgui  # STATIC libraries
     libavcodec libavutil           # FFmpeg (vendored build)
-    # CLI tool
-    rexglue
 )
 
+# The recompiler and CLI tool aren't built for UWP.
+if(NOT REXGLUE_UWP)
+    list(APPEND REXGLUE_INSTALL_TARGETS rexcodegen rexglue)
+endif()
+
 if(REXGLUE_USE_VULKAN)
     list(APPEND REXGLUE_INSTALL_TARGETS
         SPIRV glslang MachineIndependent GenericCodeGen OSDependent OGLCompiler  # glslang
@@ -90,9 +95,17 @@ endif()
 install(FILES
     src/ui/windowed_app_main_win.cpp
     src/ui/windowed_app_main_posix.cpp
+    src/ui/windowed_app_main_uwp.cpp
     DESTINATION ${CMAKE_INSTALL_DATADIR}/rexglue
 )
 
+# Install UWP packaging helpers (manifest template, packaging script).
+if(REXGLUE_UWP)
+    install(DIRECTORY cmake/uwp/
+        DESTINATION ${CMAKE_INSTALL_DATADIR}/rexglue/uwp
+    )
+endif()
+
 # Install DXC API headers (vendored, for D3D12 backend)
 if(REXGLUE_USE_D3D12)
     install(FILES
diff --git a/cmake/uwp/AppxManifest.xml.in b/cmake/uwp/AppxManifest.xml.in
new file mode 100644
index 0000000..3c1ef24
--- /dev/null
+++ b/cmake/uwp/AppxManifest.xml.in
@@ -0,0 +1,57 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  UWP package manifest for a ReXGlue game (Xbox Developer Mode). Generated by
+  rexglue_uwp_app() in rexglue_uwp.cmake - edit the template, not the copy in
+  the build folder.
+-->
+<Package
+  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
+  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
+  IgnorableNamespaces="uap">
+
+  <Identity
+    Name="@UWP_NAME@"
+    Publisher="@UWP_PUBLISHER@"
+    Version="@UWP_VERSION@"
+    ProcessorArchitecture="x64" />
+
+  <Properties>
+    <DisplayName>@UWP_DISPLAY_NAME@</DisplayName>
+    <PublisherDisplayName>@UWP_PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
+    <Logo>Images\StoreLogo.png</Logo>
+  </Properties>
+
+  <Dependencies>
+    <!-- 1809 or newer; Xbox system software is well past this. -->
+    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
+    <!-- The app-container C++ runtime. Deploy Microsoft.VCLibs.x64.14.00.appx
+         (or the .Debug one for Debug builds) together with the app. -->
+    <PackageDependency
+      Name="@UWP_VCLIBS_NAME@"
+      MinVersion="14.0.24217.0"
+      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
+  </Dependencies>
+
+  <Resources>
+    <Resource Language="en-us" />
+  </Resources>
+
+  <Applications>
+    <Application Id="App" Executable="@UWP_EXECUTABLE@" EntryPoint="@UWP_ENTRY_POINT@">
+      <uap:VisualElements
+        DisplayName="@UWP_DISPLAY_NAME@"
+        Description="@UWP_DESCRIPTION@"
+        BackgroundColor="#101418"
+        Square150x150Logo="Images\Square150x150Logo.png"
+        Square44x44Logo="Images\Square44x44Logo.png">
+        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png" />
+        <uap:SplashScreen Image="Images\SplashScreen.png" BackgroundColor="#101418" />
+      </uap:VisualElements>
+    </Application>
+  </Applications>
+
+  <Capabilities>
+    <!-- Lets the guest's networking code (Winsock) initialize. -->
+    <Capability Name="internetClient" />
+  </Capabilities>
+</Package>
