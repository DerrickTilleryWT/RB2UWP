+/**
+ * @file        input/winrt/winrt_input_driver.cpp
+ *
+ * @brief       Controller input through Windows.Gaming.Input, for UWP builds
+ *              (Xbox Developer Mode). Keystroke generation mirrors the SDL
+ *              driver so games see identical XInput behavior.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/input/winrt/winrt_input_driver.h>
+
+#if REX_PLATFORM_WINRT
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <iterator>
+#include <tuple>
+#include <vector>
+
+#include <roapi.h>
+#include <winstring.h>
+#include <wrl/client.h>
+
+#include <windows.gaming.input.h>
+
+#include <rex/assert.h>
+#include <rex/cvar.h>
+#include <rex/input/flags.h>
+#include <rex/logging.h>
+#include <rex/time/clock.h>
+#include <rex/ui/virtual_key.h>
+
+// Defined by the SDL driver on other platforms.
+REXCVAR_DEFINE_BOOL(guide_button, false,
+    "Enable guide button pass-through",
+    "Input");
+
+REXCVAR_DEFINE_STRING(hid_mappings_file, "",
+    "Path to SDL gamecontroller mappings file (unused on UWP)",
+    "Input");
+
+namespace rex::input::winrt {
+
+namespace wgi = ABI::Windows::Gaming::Input;
+namespace wfc = ABI::Windows::Foundation::Collections;
+using Microsoft::WRL::ComPtr;
+
+namespace {
+
+constexpr int16_t kThumbThreshold = 0x4E00;
+constexpr uint8_t kTriggerThreshold = 0x1F;
+constexpr uint32_t kRepeatDelayMs = 400;
+constexpr uint32_t kRepeatRateMs = 100;
+constexpr auto kListRefreshInterval = std::chrono::milliseconds(250);
+
+// Guest threads call into input without having entered the Windows Runtime.
+// Joining the multithreaded apartment makes the (agile) Windows.Gaming.Input
+// objects usable from them. A thread already in an STA keeps it, which is fine.
+void EnsureThreadInWindowsRuntime() {
+  thread_local bool initialized = false;
+  if (!initialized) {
+    RoInitialize(RO_INIT_MULTITHREADED);
+    initialized = true;
+  }
+}
+
+int16_t AxisToShort(double value) {
+  value = std::clamp(value, -1.0, 1.0);
+  return int16_t(std::lround(value * 32767.0));
+}
+
+uint8_t TriggerToByte(double value) {
+  value = std::clamp(value, 0.0, 1.0);
+  return uint8_t(std::lround(value * 255.0));
+}
+
+uint16_t ConvertButtons(wgi::GamepadButtons buttons) {
+  const uint32_t b = uint32_t(buttons);
+  uint16_t x = 0;
+  auto map = [&](uint32_t wgi_bit, uint16_t x_bit) {
+    if (b & wgi_bit) {
+      x |= x_bit;
+    }
+  };
+  map(wgi::GamepadButtons_DPadUp, X_INPUT_GAMEPAD_DPAD_UP);
+  map(wgi::GamepadButtons_DPadDown, X_INPUT_GAMEPAD_DPAD_DOWN);
+  map(wgi::GamepadButtons_DPadLeft, X_INPUT_GAMEPAD_DPAD_LEFT);
+  map(wgi::GamepadButtons_DPadRight, X_INPUT_GAMEPAD_DPAD_RIGHT);
+  map(wgi::GamepadButtons_Menu, X_INPUT_GAMEPAD_START);
+  map(wgi::GamepadButtons_View, X_INPUT_GAMEPAD_BACK);
+  map(wgi::GamepadButtons_LeftThumbstick, X_INPUT_GAMEPAD_LEFT_THUMB);
+  map(wgi::GamepadButtons_RightThumbstick, X_INPUT_GAMEPAD_RIGHT_THUMB);
+  map(wgi::GamepadButtons_LeftShoulder, X_INPUT_GAMEPAD_LEFT_SHOULDER);
+  map(wgi::GamepadButtons_RightShoulder, X_INPUT_GAMEPAD_RIGHT_SHOULDER);
+  map(wgi::GamepadButtons_A, X_INPUT_GAMEPAD_A);
+  map(wgi::GamepadButtons_B, X_INPUT_GAMEPAD_B);
+  map(wgi::GamepadButtons_X, X_INPUT_GAMEPAD_X);
+  map(wgi::GamepadButtons_Y, X_INPUT_GAMEPAD_Y);
+  return x;
+}
+
+bool IsSameObject(IUnknown* a, IUnknown* b) {
+  if (!a || !b) {
+    return a == b;
+  }
+  ComPtr<IUnknown> identity_a, identity_b;
+  if (FAILED(a->QueryInterface(IID_PPV_ARGS(identity_a.GetAddressOf()))) ||
+      FAILED(b->QueryInterface(IID_PPV_ARGS(identity_b.GetAddressOf())))) {
+    return false;
+  }
+  return identity_a.Get() == identity_b.Get();
+}
+
+}  // namespace
+
+struct WinRTInputDriver::Impl {
+  ComPtr<wgi::IGamepadStatics> statics;
+  std::array<ComPtr<wgi::IGamepad>, kUserCount> gamepads;
+};
+
+WinRTInputDriver::WinRTInputDriver(rex::ui::Window* window,
+                                   size_t window_z_order)
+    : InputDriver(window, window_z_order), impl_(std::make_unique<Impl>()) {}
+
+WinRTInputDriver::~WinRTInputDriver() = default;
+
+X_STATUS WinRTInputDriver::Setup() {
+  EnsureThreadInWindowsRuntime();
+
+  static const wchar_t kClassName[] = L"Windows.Gaming.Input.Gamepad";
+  HSTRING_HEADER class_name_header;
+  HSTRING class_name = nullptr;
+  if (FAILED(WindowsCreateStringReference(
+          kClassName, UINT32(std::size(kClassName) - 1), &class_name_header,
+          &class_name))) {
+    return X_STATUS_UNSUCCESSFUL;
+  }
+  HRESULT result = RoGetActivationFactory(
+      class_name, IID_PPV_ARGS(impl_->statics.GetAddressOf()));
+  if (FAILED(result) || !impl_->statics) {
+    REXLOG_ERROR(
+        "Windows.Gaming.Input: failed to get the Gamepad statics (0x{:08X})",
+        uint32_t(result));
+    return X_STATUS_UNSUCCESSFUL;
+  }
+
+  std::unique_lock<std::mutex> guard(mutex_);
+  UpdateLocked();
+  REXLOG_INFO("Windows.Gaming.Input driver initialized");
+  return X_STATUS_SUCCESS;
+}
+
+void WinRTInputDriver::UpdateLocked() {
+  if (!impl_->statics) {
+    return;
+  }
+  EnsureThreadInWindowsRuntime();
+
+  // Refresh the controller list periodically, keeping existing controllers in
+  // their slots so a disconnect doesn't reassign players.
+  auto now = std::chrono::steady_clock::now();
+  if (now - last_list_refresh_ >= kListRefreshInterval) {
+    last_list_refresh_ = now;
+    ComPtr<wfc::IVectorView<wgi::Gamepad*>> list;
+    if (SUCCEEDED(impl_->statics->get_Gamepads(list.GetAddressOf())) &&
+        list) {
+      unsigned int size = 0;
+      list->get_Size(&size);
+      std::vector<ComPtr<wgi::IGamepad>> connected;
+      connected.reserve(size);
+      for (unsigned int i = 0; i < size; ++i) {
+        ComPtr<wgi::IGamepad> gamepad;
+        if (SUCCEEDED(list->GetAt(i, gamepad.GetAddressOf())) && gamepad) {
+          connected.push_back(std::move(gamepad));
+        }
+      }
+      // Drop slots whose controller is gone.
+      for (uint32_t slot = 0; slot < kUserCount; ++slot) {
+        auto& slot_gamepad = impl_->gamepads[slot];
+        if (!slot_gamepad) {
+          continue;
+        }
+        auto it = std::find_if(
+            connected.begin(), connected.end(), [&](const auto& gamepad) {
+              return IsSameObject(slot_gamepad.Get(), gamepad.Get());
+            });
+        if (it == connected.end()) {
+          REXLOG_INFO("Windows.Gaming.Input: controller removed from slot {}",
+                      slot);
+          slot_gamepad.Reset();
+          controllers_[slot] = {};
+          keystroke_states_[slot] = {};
+        } else {
+          connected.erase(it);
+        }
+      }
+      // Put new controllers in the free slots.
+      for (auto& gamepad : connected) {
+        for (uint32_t slot = 0; slot < kUserCount; ++slot) {
+          if (impl_->gamepads[slot]) {
+            continue;
+          }
+          impl_->gamepads[slot] = gamepad;
+          ControllerState& controller = controllers_[slot];
+          controller = {};
+          controller.connected = true;
+          // XInput seems to start with packet_number = 1.
+          controller.state_changed = true;
+          ComPtr<wgi::IGameController> game_controller;
+          if (SUCCEEDED(gamepad.As(&game_controller))) {
+            boolean wireless = false;
+            if (SUCCEEDED(game_controller->get_IsWireless(&wireless))) {
+              controller.wireless = wireless != 0;
+            }
+          }
+          REXLOG_INFO("Windows.Gaming.Input: controller added at slot {}",
+                      slot);
+          break;
+        }
+      }
+    }
+  }
+
+  // Read the current state of every connected controller.
+  for (uint32_t slot = 0; slot < kUserCount; ++slot) {
+    auto& gamepad = impl_->gamepads[slot];
+    if (!gamepad) {
+      continue;
+    }
+    wgi::GamepadReading reading = {};
+    if (FAILED(gamepad->GetCurrentReading(&reading))) {
+      continue;
+    }
+    ControllerState& controller = controllers_[slot];
+    if (reading.Timestamp == controller.last_timestamp) {
+      continue;
+    }
+    controller.last_timestamp = reading.Timestamp;
+    X_INPUT_GAMEPAD& pad = controller.state.gamepad;
+    pad.buttons = ConvertButtons(reading.Buttons);
+    pad.left_trigger = TriggerToByte(reading.LeftTrigger);
+    pad.right_trigger = TriggerToByte(reading.RightTrigger);
+    // Windows.Gaming.Input and XInput both use +Y as up.
+    pad.thumb_lx = AxisToShort(reading.LeftThumbstickX);
+    pad.thumb_ly = AxisToShort(reading.LeftThumbstickY);
+    pad.thumb_rx = AxisToShort(reading.RightThumbstickX);
+    pad.thumb_ry = AxisToShort(reading.RightThumbstickY);
+    controller.state_changed = true;
+  }
+}
+
+X_RESULT WinRTInputDriver::GetCapabilities(uint32_t user_index,
+                                           uint32_t flags,
+                                           X_INPUT_CAPABILITIES* out_caps) {
+  (void)flags;
+  if (user_index >= kUserCount || !out_caps) {
+    return X_ERROR_BAD_ARGUMENTS;
+  }
+  std::unique_lock<std::mutex> guard(mutex_);
+  UpdateLocked();
+  const ControllerState& controller = controllers_[user_index];
+  if (!controller.connected) {
+    return X_ERROR_DEVICE_NOT_CONNECTED;
+  }
+  X_INPUT_CAPABILITIES caps = {};
+  caps.type = 0x01;      // XINPUT_DEVTYPE_GAMEPAD
+  caps.sub_type = 0x01;  // XINPUT_DEVSUBTYPE_GAMEPAD
+  caps.flags = controller.wireless ? uint16_t(X_INPUT_CAPS_WIRELESS) : 0;
+  caps.gamepad.buttons =
+      0xF3FF | (REXCVAR_GET(guide_button) ? X_INPUT_GAMEPAD_GUIDE : 0x0);
+  caps.gamepad.left_trigger = 0xFF;
+  caps.gamepad.right_trigger = 0xFF;
+  caps.gamepad.thumb_lx = static_cast<int16_t>(0xFFFFu);
+  caps.gamepad.thumb_ly = static_cast<int16_t>(0xFFFFu);
+  caps.gamepad.thumb_rx = static_cast<int16_t>(0xFFFFu);
+  caps.gamepad.thumb_ry = static_cast<int16_t>(0xFFFFu);
+  caps.vibration.left_motor_speed = 0xFFFFu;
+  caps.vibration.right_motor_speed = 0xFFFFu;
+  *out_caps = caps;
+  return X_ERROR_SUCCESS;
+}
+
+X_RESULT WinRTInputDriver::GetState(uint32_t user_index,
+                                    X_INPUT_STATE* out_state) {
+  if (user_index >= kUserCount || !out_state) {
+    return X_ERROR_BAD_ARGUMENTS;
+  }
+  const bool is_active = this->is_active();
+  std::unique_lock<std::mutex> guard(mutex_);
+  if (is_active) {
+    UpdateLocked();
+  }
+  ControllerState& controller = controllers_[user_index];
+  if (!controller.connected) {
+    return X_ERROR_DEVICE_NOT_CONNECTED;
+  }
+  // Increment packet_number once per observed change, and when the active
+  // state flips, like the SDL driver.
+  if ((is_active != controller.is_active) ||
+      (is_active && controller.state_changed)) {
+    controller.state.packet_number = controller.state.packet_number + 1;
+    controller.is_active = is_active;
+    controller.state_changed = false;
+  }
+  *out_state = controller.state;
+  if (!is_active) {
+    // Simulate an untouched controller while input isn't routed to the game.
+    std::memset(&out_state->gamepad, 0, sizeof(out_state->gamepad));
+  }
+  return X_ERROR_SUCCESS;
+}
+
+X_RESULT WinRTInputDriver::SetState(uint32_t user_index,
+                                    X_INPUT_VIBRATION* vibration) {
+  if (user_index >= kUserCount || !vibration) {
+    return X_ERROR_BAD_ARGUMENTS;
+  }
+  std::unique_lock<std::mutex> guard(mutex_);
+  UpdateLocked();
+  auto& gamepad = impl_->gamepads[user_index];
+  if (!gamepad || !controllers_[user_index].connected) {
+    return X_ERROR_DEVICE_NOT_CONNECTED;
+  }
+  wgi::GamepadVibration wgi_vibration = {};
+  wgi_vibration.LeftMotor = double(uint16_t(vibration->left_motor_speed)) / 65535.0;
+  wgi_vibration.RightMotor =
+      double(uint16_t(vibration->right_motor_speed)) / 65535.0;
+  if (FAILED(gamepad->put_Vibration(wgi_vibration))) {
+    return X_ERROR_FUNCTION_FAILED;
+  }
+  return X_ERROR_SUCCESS;
+}
+
+X_RESULT WinRTInputDriver::GetKeystroke(uint32_t users, uint32_t flags,
+                                        X_INPUT_KEYSTROKE* out_keystroke) {
+  (void)flags;
+  const bool user_any = users == 0xFF;
+  if (users >= kUserCount && !user_any) {
+    return X_ERROR_BAD_ARGUMENTS;
+  }
+  if (!out_keystroke) {
+    return X_ERROR_BAD_ARGUMENTS;
+  }
+
+  // The order of this list is also the order in which events are sent if
+  // multiple buttons change at once (same as the SDL driver).
+  static constexpr std::array<rex::ui::VirtualKey, 34> kVkLookup = {
+      // 00 - True buttons from xinput button field
+      rex::ui::VirtualKey::kXInputPadDpadUp,
+      rex::ui::VirtualKey::kXInputPadDpadDown,
+      rex::ui::VirtualKey::kXInputPadDpadLeft,
+      rex::ui::VirtualKey::kXInputPadDpadRight,
+      rex::ui::VirtualKey::kXInputPadStart,
+      rex::ui::VirtualKey::kXInputPadBack,
+      rex::ui::VirtualKey::kXInputPadLThumbPress,
+      rex::ui::VirtualKey::kXInputPadRThumbPress,
+      rex::ui::VirtualKey::kXInputPadLShoulder,
+      rex::ui::VirtualKey::kXInputPadRShoulder,
+      rex::ui::VirtualKey::kNone, /* Guide has no VK */
+      rex::ui::VirtualKey::kNone, /* Unknown */
+      rex::ui::VirtualKey::kXInputPadA,
+      rex::ui::VirtualKey::kXInputPadB,
+      rex::ui::VirtualKey::kXInputPadX,
+      rex::ui::VirtualKey::kXInputPadY,
+      // 16 - Fake buttons generated from analog inputs
+      rex::ui::VirtualKey::kXInputPadLTrigger,
+      rex::ui::VirtualKey::kXInputPadRTrigger,
+      // 18
+      rex::ui::VirtualKey::kXInputPadLThumbUp,
+      rex::ui::VirtualKey::kXInputPadLThumbDown,
+      rex::ui::VirtualKey::kXInputPadLThumbRight,
+      rex::ui::VirtualKey::kXInputPadLThumbLeft,
+      rex::ui::VirtualKey::kXInputPadLThumbUpLeft,
+      rex::ui::VirtualKey::kXInputPadLThumbUpRight,
+      rex::ui::VirtualKey::kXInputPadLThumbDownRight,
+      rex::ui::VirtualKey::kXInputPadLThumbDownLeft,
+      // 26
+      rex::ui::VirtualKey::kXInputPadRThumbUp,
+      rex::ui::VirtualKey::kXInputPadRThumbDown,
+      rex::ui::VirtualKey::kXInputPadRThumbRight,
+      rex::ui::VirtualKey::kXInputPadRThumbLeft,
+      rex::ui::VirtualKey::kXInputPadRThumbUpLeft,
+      rex::ui::VirtualKey::kXInputPadRThumbUpRight,
+      rex::ui::VirtualKey::kXInputPadRThumbDownRight,
+      rex::ui::VirtualKey::kXInputPadRThumbDownLeft,
+  };
+
+  const bool is_active = this->is_active();
+  std::unique_lock<std::mutex> guard(mutex_);
+  if (is_active) {
+    UpdateLocked();
+  }
+
+  for (uint32_t user_index = (user_any ? 0 : users);
+       user_index < (user_any ? kUserCount : users + 1); user_index++) {
+    const ControllerState& controller = controllers_[user_index];
+    if (!controller.connected) {
+      if (user_any) {
+        continue;
+      }
+      return X_ERROR_DEVICE_NOT_CONNECTED;
+    }
+
+    // If input is not active, force buttons to "unpressed" so UP events are
+    // sent, and DOWN events again once it becomes active.
+    const uint64_t curr_butts =
+        is_active ? (uint64_t(uint16_t(controller.state.gamepad.buttons)) |
+                     AnalogToKeyfield(controller.state.gamepad))
+                  : uint64_t(0);
+    KeystrokeState& last = keystroke_states_[user_index];
+
+    // Handle repeating.
+    auto guest_now =
+        uint32_t(rex::chrono::Clock::QueryGuestUptimeMillis());
+    if (last.repeat_state == RepeatState::Waiting &&
+        (last.repeat_time + kRepeatDelayMs < guest_now)) {
+      last.repeat_state = RepeatState::Repeating;
+    }
+    if (last.repeat_state == RepeatState::Repeating &&
+        (last.repeat_time + kRepeatRateMs < guest_now)) {
+      last.repeat_time = guest_now;
+      rex::ui::VirtualKey vk = kVkLookup.at(last.repeat_butt_idx);
+      assert_true(vk != rex::ui::VirtualKey::kNone);
+      out_keystroke->virtual_key = uint16_t(vk);
+      out_keystroke->unicode = 0;
+      out_keystroke->user_index = uint8_t(user_index);
+      out_keystroke->hid_code = 0;
+      out_keystroke->flags =
+          X_INPUT_KEYSTROKE_KEYDOWN | X_INPUT_KEYSTROKE_REPEAT;
+      return X_ERROR_SUCCESS;
+    }
+
+    auto butts_changed = curr_butts ^ last.buttons;
+    if (!butts_changed) {
+      continue;
+    }
+
+    // First clear buttons with up events, then press with down events, to
+    // match XInput when transitioning thumb stick directions.
+    for (int pass = 0; pass < 2; ++pass) {
+      const bool clear_pass = pass == 0;
+      for (uint8_t i = 0; i < uint8_t(std::size(kVkLookup)); i++) {
+        auto fbutton = uint64_t(1) << i;
+        if (!(butts_changed & fbutton)) {
+          continue;
+        }
+        rex::ui::VirtualKey vk = kVkLookup.at(i);
+        if (vk == rex::ui::VirtualKey::kNone) {
+          continue;
+        }
+        out_keystroke->virtual_key = uint16_t(vk);
+        out_keystroke->unicode = 0;
+        out_keystroke->user_index = uint8_t(user_index);
+        out_keystroke->hid_code = 0;
+
+        bool is_pressed = (curr_butts & fbutton) != 0;
+        if (clear_pass && !is_pressed) {
+          out_keystroke->flags = X_INPUT_KEYSTROKE_KEYUP;
+          last.buttons &= ~fbutton;
+          last.repeat_state = RepeatState::Idle;
+          return X_ERROR_SUCCESS;
+        }
+        if (!clear_pass && is_pressed) {
+          out_keystroke->flags = X_INPUT_KEYSTROKE_KEYDOWN;
+          last.buttons |= fbutton;
+          last.repeat_state = RepeatState::Waiting;
+          last.repeat_butt_idx = i;
+          last.repeat_time = guest_now;
+          return X_ERROR_SUCCESS;
+        }
+      }
+    }
+  }
+  return X_ERROR_EMPTY;
+}
+
+// Check if the analog inputs exceed their thresholds to become a button press
+// and build the bitfield (same layout as the SDL driver).
+uint64_t WinRTInputDriver::AnalogToKeyfield(
+    const X_INPUT_GAMEPAD& gamepad) const {
+  uint64_t f = 0;
+
+  f |= static_cast<uint64_t>(gamepad.left_trigger > kTriggerThreshold) << 16;
+  f |= static_cast<uint64_t>(gamepad.right_trigger > kTriggerThreshold) << 17;
+
+  auto thumb_x = static_cast<int16_t>(gamepad.thumb_lx);
+  auto thumb_y = static_cast<int16_t>(gamepad.thumb_ly);
+  for (size_t i = 0; i <= 8; i = i + 8) {
+    uint64_t u = thumb_y > kThumbThreshold;
+    uint64_t d = thumb_y < ~kThumbThreshold;
+    uint64_t r = thumb_x > kThumbThreshold;
+    uint64_t l = thumb_x < ~kThumbThreshold;
+    if (u && l) {
+      u = l = 0;
+      f |= uint64_t(1) << (22 + i);
+    }
+    if (u && r) {
+      u = r = 0;
+      f |= uint64_t(1) << (23 + i);
+    }
+    if (d && r) {
+      d = r = 0;
+      f |= uint64_t(1) << (24 + i);
+    }
+    if (d && l) {
+      d = l = 0;
+      f |= uint64_t(1) << (25 + i);
+    }
+    f |= u << (18 + i);
+    f |= d << (19 + i);
+    f |= r << (20 + i);
+    f |= l << (21 + i);
+
+    thumb_x = static_cast<int16_t>(gamepad.thumb_rx);
+    thumb_y = static_cast<int16_t>(gamepad.thumb_ry);
+  }
+  return f;
+}
+
+}  // namespace rex::input::winrt
+
+#endif  // REX_PLATFORM_WINRT
