new file mode 100644
index 0000000..72cbd5b
--- /dev/null
+++ b/cmake/uwp/rexglue_uwp.cmake
@@ -0,0 +1,112 @@
+# ReXGlue UWP app helpers (Xbox Developer Mode).
+#
+# Included automatically by find_package(rexglue) when the SDK was built with
+# REXGLUE_UWP=ON. Provides rexglue_uwp_app(), which turns a game executable
+# into a UWP package layout and adds a <target>_package target that builds a
+# signed .msix with package_uwp.ps1.
+#
+#   rexglue_uwp_app(<target>
+#       NAME <identity name>          # e.g. "ReXGlue.RB2": letters, digits, '.', '-'
+#       DISPLAY_NAME <text>           # shown on the Xbox home screen
+#       PUBLISHER <distinguished name># e.g. "CN=ReXGlue" - the signing certificate's subject
+#       [PUBLISHER_DISPLAY_NAME <text>]
+#       [DESCRIPTION <text>]
+#       [VERSION <a.b.c.d>]           # default 1.0.0.0
+#       [IMAGES_DIR <dir>]            # PNGs replacing the default tile images (same names)
+#       [GAME_FILES_DIR <dir>]        # game files packaged as "assets" (default: none)
+#   )
+#
+# The layout is written to <build dir>/uwp/<target>/<config>/layout after each
+# build. Game files aren't copied there (they can be several gigabytes) -
+# package_uwp.ps1 maps them into the package directly.
+
+include_guard(GLOBAL)
+
+include("${CMAKE_CURRENT_LIST_DIR}/rexglue_uwp_toolchain.cmake")
+
+set(REXGLUE_UWP_DIR "${CMAKE_CURRENT_LIST_DIR}" CACHE INTERNAL "")
+
+function(rexglue_uwp_app target)
+    cmake_parse_arguments(PARSE_ARGV 1 ARG ""
+        "NAME;DISPLAY_NAME;PUBLISHER;PUBLISHER_DISPLAY_NAME;DESCRIPTION;VERSION;IMAGES_DIR;GAME_FILES_DIR"
+        "")
+    foreach(required NAME DISPLAY_NAME PUBLISHER)
+        if(NOT ARG_${required})
+            message(FATAL_ERROR "rexglue_uwp_app(${target}): ${required} is required")
+        endif()
+    endforeach()
+    if(NOT ARG_VERSION)
+        set(ARG_VERSION "1.0.0.0")
+    endif()
+    if(NOT ARG_PUBLISHER_DISPLAY_NAME)
+        set(ARG_PUBLISHER_DISPLAY_NAME "${ARG_DISPLAY_NAME}")
+    endif()
+    if(NOT ARG_DESCRIPTION)
+        set(ARG_DESCRIPTION "${ARG_DISPLAY_NAME}")
+    endif()
+    if(NOT ARG_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$")
+        message(FATAL_ERROR "rexglue_uwp_app(${target}): VERSION must look like 1.0.0.0")
+    endif()
+
+    # The executable runs in the app container.
+    target_link_options(${target} PRIVATE "LINKER:/APPCONTAINER")
+
+    # Manifest: substitute the package fields now, and the executable name and
+    # C runtime package (debug or release) per configuration.
+    set(UWP_NAME "${ARG_NAME}")
+    set(UWP_DISPLAY_NAME "${ARG_DISPLAY_NAME}")
+    set(UWP_PUBLISHER "${ARG_PUBLISHER}")
+    set(UWP_PUBLISHER_DISPLAY_NAME "${ARG_PUBLISHER_DISPLAY_NAME}")
+    set(UWP_DESCRIPTION "${ARG_DESCRIPTION}")
+    set(UWP_VERSION "${ARG_VERSION}")
+    set(UWP_EXECUTABLE "$<TARGET_FILE_NAME:${target}>")
+    set(UWP_ENTRY_POINT "${target}.App")
+    set(UWP_VCLIBS_NAME
+        "Microsoft.VCLibs.140.00$<$<CONFIG:Debug>:.Debug>")
+    foreach(field DISPLAY_NAME PUBLISHER PUBLISHER_DISPLAY_NAME DESCRIPTION)
+        string(REPLACE "&" "&amp;" UWP_${field} "${UWP_${field}}")
+        string(REPLACE "<" "&lt;" UWP_${field} "${UWP_${field}}")
+        string(REPLACE "\"" "&quot;" UWP_${field} "${UWP_${field}}")
+    endforeach()
+
+    set(uwp_root "${CMAKE_CURRENT_BINARY_DIR}/uwp/${target}")
+    configure_file("${REXGLUE_UWP_DIR}/AppxManifest.xml.in"
+        "${uwp_root}/AppxManifest.xml.genex" @ONLY)
+    file(GENERATE
+        OUTPUT "${uwp_root}/$<CONFIG>/AppxManifest.xml"
+        INPUT "${uwp_root}/AppxManifest.xml.genex")
+
+    if(ARG_IMAGES_DIR)
+        get_filename_component(images_dir "${ARG_IMAGES_DIR}" ABSOLUTE)
+    else()
+        set(images_dir "${REXGLUE_UWP_DIR}/images")
+    endif()
+
+    set(layout_dir "${uwp_root}/$<CONFIG>/layout")
+    add_custom_command(TARGET ${target} POST_BUILD
+        COMMAND ${CMAKE_COMMAND} -E make_directory "${layout_dir}/Images"
+        COMMAND ${CMAKE_COMMAND} -E copy_if_different
+            "$<TARGET_FILE:${target}>" "${layout_dir}/"
+        COMMAND ${CMAKE_COMMAND} -E copy_if_different
+            "${uwp_root}/$<CONFIG>/AppxManifest.xml" "${layout_dir}/AppxManifest.xml"
+        COMMAND ${CMAKE_COMMAND} -E copy_directory
+            "${images_dir}" "${layout_dir}/Images"
+        COMMENT "Updating the UWP package layout for ${target}"
+        VERBATIM)
+
+    # <target>_package: build and sign the .msix (Windows SDK tools, run with
+    # PowerShell).
+    set(package_args
+        -Layout "${layout_dir}"
+        -Output "${uwp_root}/$<CONFIG>/${ARG_NAME}_${ARG_VERSION}_x64.msix")
+    if(ARG_GAME_FILES_DIR)
+        get_filename_component(game_files_dir "${ARG_GAME_FILES_DIR}" ABSOLUTE)
+        list(APPEND package_args -GameFiles "${game_files_dir}")
+    endif()
+    add_custom_target(${target}_package
+        COMMAND powershell -NoProfile -ExecutionPolicy Bypass
+            -File "${REXGLUE_UWP_DIR}/package_uwp.ps1" ${package_args}
+        DEPENDS ${target}
+        COMMENT "Packaging ${target} as a UWP .msix"
+        VERBATIM)
+endfunction()
diff --git a/cmake/uwp/rexglue_uwp_toolchain.cmake b/cmake/uwp/rexglue_uwp_toolchain.cmake
new file mode 100644
index 0000000..9536fc2
--- /dev/null
+++ b/cmake/uwp/rexglue_uwp_toolchain.cmake
@@ -0,0 +1,36 @@
+# ReXGlue UWP toolchain settings (Xbox Developer Mode).
+#
+# Shared by the SDK's own UWP build and by games built against a UWP build of
+# the SDK (rexglue_uwp.cmake includes this). Must be included before any
+# targets are created.
+#
+# Build from a Visual Studio developer prompt set up for UWP, so the linker
+# finds the app-container C runtime and WindowsApp.lib:
+#   "C:\Program Files\Microsoft Visual Studio\2022\Community\VC\Auxiliary\Build\vcvarsall.bat" x64 uwp
+
+include_guard(GLOBAL)
+
+# UWP apps must use the dynamic app-container C runtime (vcruntime140_app.dll
+# and msvcp140_app.dll, supplied on the device by the Microsoft.VCLibs
+# framework package); the static CRT isn't allowed in the app container.
+set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
+if(CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "GNU")
+    # clang's GNU-style driver (clang/clang++ rather than clang-cl) defaults to
+    # the static CRT, and not every CMake version maps the setting above to it.
+    add_compile_options("$<IF:$<CONFIG:Debug>,-fms-runtime-lib=dll_dbg,-fms-runtime-lib=dll>")
+endif()
+
+# Link against WindowsApp.lib (the API surface available to UWP apps) instead
+# of the desktop system import libraries CMake adds by default.
+set(CMAKE_C_STANDARD_LIBRARIES "WindowsApp.lib")
+set(CMAKE_CXX_STANDARD_LIBRARIES "WindowsApp.lib")
+
+# The app-container libraries live in "store" folders of the MSVC and Windows
+# SDK lib directories, which vcvarsall.bat only adds for the "uwp" platform.
+if(DEFINED ENV{LIB} AND NOT "$ENV{LIB}" MATCHES "[\\\\/][Ss]tore")
+    message(WARNING
+        "REXGLUE_UWP: the LIB environment variable doesn't include the UWP "
+        "(\"store\") library folders, so the desktop C runtime will be linked "
+        "and the app won't start on Xbox. Configure from a prompt set up with "
+        "'vcvarsall.bat x64 uwp'.")
+endif()
diff --git a/docs/UWP.md b/docs/UWP.md
new file mode 100644
index 0000000..cf57c79
--- /dev/null
+++ b/docs/UWP.md
@@ -0,0 +1,75 @@
+# UWP builds (Xbox Developer Mode)
+
+ReXGlue can be built as a UWP (Universal Windows Platform) app, which is what
+an Xbox Series X|S in Developer Mode runs. `REXGLUE_UWP=ON` switches the
+platform layer:
+
+| Area | Desktop Windows | UWP |
+| --- | --- | --- |
+| Window and UI loop | Win32 HWND | `CoreApplication` / `CoreWindow` (`window_uwp.cpp`, `windowed_app_context_uwp.cpp`, `windowed_app_main_uwp.cpp`) |
+| Swap chain | `CreateSwapChainForHwnd` | `CreateSwapChainForCoreWindow` |
+| Direct3D 12 / DXGI | loaded with `LoadLibrary` | linked (`d3d12.lib`, `dxgi.lib`); shader disassembly DLLs unavailable |
+| Controllers | SDL2 | `Windows.Gaming.Input` (`input/winrt`) |
+| Audio | SDL2 | XAudio2 (`audio/xaudio2`) |
+| User data, logs | Documents, working directory | the package's LocalState folder |
+| Command line | `argv` | `LocalState\args.txt` (one argument per line) and `LocalState\config.toml` |
+| Vulkan, codegen, `rexglue` CLI | available | not built |
+
+Only Xbox Series X|S are supported: the SDK is built for `x86-64-v3` (AVX2),
+which Xbox One CPUs lack.
+
+## Building the SDK
+
+From a Visual Studio 2022 developer prompt set up for UWP, with the
+"Universal Windows Platform development" and "Desktop development with C++"
+workloads and the LLVM/Clang (18+) component installed:
+
+```bat
+"C:\Program Files\Microsoft Visual Studio\2022\Community\VC\Auxiliary\Build\vcvarsall.bat" x64 uwp
+cmake --preset uwp-amd64
+cmake --build --preset uwp-amd64-release
+cmake --install out/build/uwp-amd64 --config Release
+```
+
+`vcvarsall.bat ... uwp` matters: it puts the app-container ("store") C runtime
+and `WindowsApp.lib` on the library path. Configure warns if it's missing.
+
+Code generation still needs a regular desktop or Linux build of the SDK (the
+`rexglue` CLI); the generated sources are then compiled for UWP.
+
+## Building a game
+
+A game project finds the UWP SDK with `find_package(rexglue)` as usual. The
+config then sets the UWP compile definitions and C runtime, and provides
+`rexglue_uwp_app()`:
+
+```cmake
+if(REXGLUE_UWP)
+    rexglue_uwp_app(mygame
+        NAME "ReXGlue.MyGame"
+        DISPLAY_NAME "My Game"
+        PUBLISHER "CN=ReXGlue")
+endif()
+```
+
+The game's entry point source is `${REXGLUE_SHARE_DIR}/windowed_app_main_uwp.cpp`
+instead of `windowed_app_main_win.cpp`. Building the game writes a package
+layout to `<build>/uwp/<target>/<config>/layout`; the `<target>_package`
+target runs `package_uwp.ps1`, which builds a signed `.msix` (creating a
+self-signed certificate for the publisher on first use) and copies the
+`Microsoft.VCLibs` framework package next to it.
+
+## Notes
+
+- Set the app's type to **Game** in Dev Home or the Device Portal after
+  installing. Apps get about 1 GB of memory and a share of the GPU; games get
+  far more.
+- Guest memory is mapped with `VirtualAlloc2FromApp` and
+  `MapViewOfFile3FromApp` placeholders, so Windows 10 1803 or newer is needed
+  (all current Xbox system software qualifies).
+- Win32 functions that exist on the OS but aren't declared for the UWP API
+  partition (vectored exception handlers, `SuspendThread`, `TerminateThread`,
+  `SignalObjectAndWait`, ...) are looked up at runtime through
+  `rex::platform::uwp::GetSystemProc`, with fallbacks where possible.
+- Logs go to `LocalState` (relative `log_file` paths) and to an attached
+  debugger; there's no console.
