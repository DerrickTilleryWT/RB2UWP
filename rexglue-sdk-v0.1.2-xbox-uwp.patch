diff --git a/include/rex/platform/uwp.h b/include/rex/platform/uwp.h
new file mode 100644
index 0000000..822671b
--- /dev/null
+++ b/include/rex/platform/uwp.h
@@ -0,0 +1,49 @@
+/**
+ * @file        platform/uwp.h
+ *
+ * @brief       Helpers for UWP (app container) builds, such as Xbox Developer
+ *              Mode: app folder locations and access to Win32 functions that
+ *              exist on the OS but are hidden from the UWP API partition.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_WINRT
+
+#include <filesystem>
+
+namespace rex::platform::uwp {
+
+// The package's LocalState folder (ApplicationData.Current.LocalFolder). This
+// is the app's private writable storage, and on Xbox it is reachable from the
+// Device Portal file explorer, so it is where game data and saves live.
+// Empty if it couldn't be obtained.
+const std::filesystem::path& GetLocalFolder();
+
+// The folder the package is installed to (read-only), which contains the
+// executable.
+const std::filesystem::path& GetInstalledFolder();
+
+// Full path of the app's executable. Empty if it couldn't be obtained.
+const std::filesystem::path& GetExecutablePath();
+
+// Looks up an export of the core system DLL (kernelbase.dll, falling back to
+// ntdll.dll) at runtime. Used for Win32 functions that are present on the OS,
+// including on Xbox, but are not declared for the UWP API partition or not
+// exported by WindowsApp.lib. Returns nullptr if not found - callers must
+// handle that.
+void* GetSystemProcAddress(const char* name);
+
+template <typename T>
+T GetSystemProc(const char* name) {
+  return reinterpret_cast<T>(GetSystemProcAddress(name));
+}
+
+}  // namespace rex::platform::uwp
+
+#endif  // REX_PLATFORM_WINRT
