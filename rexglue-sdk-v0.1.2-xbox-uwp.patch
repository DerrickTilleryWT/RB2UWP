+/*
+ * FFmpeg configuration for UWP builds of ReXGlue (Xbox Developer Mode).
+ *
+ * The regular Windows configuration, with the APIs that aren't available to
+ * UWP (app container) apps switched off. FFmpeg has its own UWP/WinRT code
+ * paths, selected by HAVE_UWP and HAVE_WINRT. This file shadows FFmpeg's own
+ * config.h through the include path order (see thirdparty/CMakeLists.txt).
+ */
+
+#include "config_windows_x86_64.h"
+
+#undef HAVE_UWP
+#define HAVE_UWP 1
+#undef HAVE_WINRT
+#define HAVE_WINRT 1
