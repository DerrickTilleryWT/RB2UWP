+/**
+ * @file        audio/xaudio2/xaudio2_audio_driver.h
+ *
+ * @brief       XAudio2 output, for UWP builds (Xbox Developer Mode) where SDL
+ *              is not available. Based on Xenia's XAudio2 driver design.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <memory>
+
+#include <rex/audio/audio_driver.h>
+#include <rex/platform.h>
+#include <rex/thread.h>
+
+#if REX_PLATFORM_WINRT
+
+struct IXAudio2;
+struct IXAudio2MasteringVoice;
+struct IXAudio2SourceVoice;
+
+namespace rex::audio::xaudio2 {
+
+class XAudio2AudioDriver : public AudioDriver {
+ public:
+  XAudio2AudioDriver(memory::Memory* memory, rex::thread::Semaphore* semaphore);
+  ~XAudio2AudioDriver() override;
+
+  bool Initialize();
+  void SubmitFrame(uint32_t frame_ptr) override;
+  void Shutdown();
+
+ private:
+  class VoiceCallback;
+
+  static constexpr uint32_t kFrameFrequency = 48000;
+  static constexpr uint32_t kFrameChannels = 6;
+  static constexpr uint32_t kChannelSamples = 256;
+  static constexpr uint32_t kFrameSamples = kFrameChannels * kChannelSamples;
+  // Matches AudioSystem::kMaximumQueuedFrames and XAUDIO2_MAX_QUEUED_BUFFERS.
+  static constexpr uint32_t kFrameCount = 64;
+
+  rex::thread::Semaphore* semaphore_ = nullptr;
+
+  IXAudio2* audio_ = nullptr;
+  IXAudio2MasteringVoice* mastering_voice_ = nullptr;
+  IXAudio2SourceVoice* source_voice_ = nullptr;
+  std::unique_ptr<VoiceCallback> voice_callback_;
+
+  std::unique_ptr<float[]> frames_;
+  uint32_t current_frame_ = 0;
+};
+
+}  // namespace rex::audio::xaudio2
+
+#endif  // REX_PLATFORM_WINRT
