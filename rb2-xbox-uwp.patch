 7 files changed, 124 insertions(+), 7 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3fa2016..25a0608 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -44,7 +44,11 @@ set(RB2_SOURCES
 )
 
 # Platform-specific entry point (provides main/wWinMain)
-if(WIN32)
+if(REXGLUE_UWP)
+    # Xbox Developer Mode (UWP): CoreApplication entry point. REXGLUE_UWP is
+    # set by find_package(rexglue) when the SDK was built for UWP.
+    list(APPEND RB2_SOURCES ${REXGLUE_SHARE_DIR}/windowed_app_main_uwp.cpp)
+elseif(WIN32)
     list(APPEND RB2_SOURCES ${REXGLUE_SHARE_DIR}/windowed_app_main_win.cpp)
 else()
     list(APPEND RB2_SOURCES ${REXGLUE_SHARE_DIR}/windowed_app_main_posix.cpp)
@@ -100,10 +104,33 @@ if(NOT MSVC)
     target_compile_options(rb2 PRIVATE -msse4.1)
 endif()
 
+# Xbox Developer Mode (UWP) package. Building rb2 updates the package layout;
+# the rb2_package target makes a signed .msix (see README).
+if(REXGLUE_UWP)
+    # Game files to put in the package (several GB). Leave empty to package
+    # only the app and copy the game files to LocalState/assets on the Xbox.
+    set(RB2_UWP_GAME_FILES "" CACHE PATH
+        "Extracted game files (with default.xex) to include in the Xbox package")
+    set(rb2_uwp_package_args)
+    if(RB2_UWP_GAME_FILES)
+        list(APPEND rb2_uwp_package_args GAME_FILES_DIR "${RB2_UWP_GAME_FILES}")
+    endif()
+    rexglue_uwp_app(rb2
+        NAME "ReXGlue.RB2"
+        DISPLAY_NAME "Raging Blast 2 Recompiled"
+        PUBLISHER "CN=ReXGlue RB2"
+        PUBLISHER_DISPLAY_NAME "rb2 (ReXGlue)"
+        DESCRIPTION "Dragon Ball: Raging Blast 2, recompiled with ReXGlue"
+        VERSION "1.0.0.0"
+        ${rb2_uwp_package_args})
+endif()
+
 # Codegen target - run 'cmake --build . --target rb2_codegen'
+if(NOT REXGLUE_UWP)  # the recompiler isn't part of a UWP SDK build
 add_custom_target(rb2_codegen
     COMMAND $<TARGET_FILE:rex::rexglue> codegen ${CMAKE_CURRENT_SOURCE_DIR}/rb2_config.toml
     WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
     COMMENT "Generating recompiled code for rb2"
     VERBATIM
 )
+endif()
