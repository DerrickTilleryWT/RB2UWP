From 929dc600f2a9dfeff16402713062081e3148b2fc Mon Sep 17 00:00:00 2001
From: dooset22 <dooset22@gmail.com>
Date: Sun, 25 Oct 2026 21:24:26 -0400
Subject: [PATCH] UWP: let FFmpeg's WinRT thread code build with Clang 16+

compat/w32pthreads.h passes a function returning unsigned to
CreateThread, which expects one returning DWORD. Both are 32-bit on
Windows, but Clang 16+ makes incompatible function pointer types an
error by default. Downgrade it for libavutil and libavcodec in UWP
builds.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01T2Eqt3AmpbNRB9dC5uwqee
---
 thirdparty/CMakeLists.txt | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/thirdparty/CMakeLists.txt b/thirdparty/CMakeLists.txt
index 838611b..0338ce5 100644
--- a/thirdparty/CMakeLists.txt
+++ b/thirdparty/CMakeLists.txt
@@ -417,6 +417,12 @@ if(REXGLUE_UWP)
     # (config.h here takes precedence over the one in the FFmpeg tree).
     target_include_directories(libavutil BEFORE PRIVATE
         ${CMAKE_CURRENT_SOURCE_DIR}/ffmpeg-uwp)
+    # FFmpeg's UWP thread code (compat/w32pthreads.h) passes a function
+    # returning unsigned to CreateThread, which expects one returning DWORD.
+    # Both are 32-bit on Windows, so it's harmless, but Clang 16+ makes the
+    # mismatch an error by default (MSVC only warns).
+    target_compile_options(libavutil PRIVATE
+        -Wno-incompatible-function-pointer-types)
 endif()
 target_compile_definitions(libavutil PRIVATE ${FFMPEG_COMMON_DEFINES})
 target_compile_options(libavutil PRIVATE -w)  # Suppress warnings in third-party code
@@ -510,6 +516,9 @@ target_include_directories(libavcodec
 if(REXGLUE_UWP)
     target_include_directories(libavcodec BEFORE PRIVATE
         ${CMAKE_CURRENT_SOURCE_DIR}/ffmpeg-uwp)
+    # See libavutil above.
+    target_compile_options(libavcodec PRIVATE
+        -Wno-incompatible-function-pointer-types)
 endif()
 target_compile_definitions(libavcodec PRIVATE ${FFMPEG_COMMON_DEFINES})
 target_compile_options(libavcodec PRIVATE -w)  # Suppress warnings in third-party code
-- 
