+    // Without working memory write watches (memory protection failed - seen
+    // on Xbox), data the game changes in place, such as dynamic vertex
+    // buffers for effects, would never be uploaded again.
+    if (shared_memory_ && (REXCVAR_GET(clear_memory_page_state) ||
