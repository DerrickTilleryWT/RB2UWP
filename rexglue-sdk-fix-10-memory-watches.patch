+                ? "clear_memory_page_state is on"
+                : "memory protection failed, so write watches don't work");
+      }
+      shared_memory_->InvalidateCpuUploadedPages();
+    }
+
     if (cache_clear_requested_ && AwaitAllQueueOperationsCompletion()) {
       cache_clear_requested_ = false;
 
diff --git a/src/graphics/shared_memory.cpp b/src/graphics/shared_memory.cpp
