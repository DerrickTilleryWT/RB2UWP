+//=============================================================================
+// Crash logging
+//=============================================================================
+
+namespace {
+
+using TopLevelFilter = LONG(WINAPI*)(EXCEPTION_POINTERS*);
+using SetUnhandledExceptionFilterFn = TopLevelFilter(WINAPI*)(TopLevelFilter);
+using GetModuleFileNameWFn = DWORD(WINAPI*)(HMODULE, LPWSTR, DWORD);
+// RtlLookupFunctionEntry and RtlVirtualUnwind, with the unwind table types
+// passed as void* (the declarations aren't in every SDK's UWP partition).
+using RtlLookupFunctionEntryFn = void*(NTAPI*)(DWORD64 control_pc,
+                                               PDWORD64 image_base,
+                                               void* history_table);
+using RtlVirtualUnwindFn = void*(NTAPI*)(DWORD handler_type,
+                                         DWORD64 image_base,
+                                         DWORD64 control_pc,
+                                         void* function_entry,
+                                         PCONTEXT context,
+                                         PVOID* handler_data,
+                                         PDWORD64 establisher_frame,
+                                         void* context_pointers);
+
+std::atomic<bool> crash_logged_{false};
+TopLevelFilter previous_filter_ = nullptr;
+
+void CrashLogLine(const std::string& line) {
+  if (auto* logger = spdlog::default_logger_raw()) {
+    logger->critical("{}", line);
+    logger->flush();
+  }
+}
+
+// "module.dll+0x1234" for an address inside a loaded module.
+std::string DescribeAddress(uint64_t address) {
+  HMODULE module = ModuleFromAddress(reinterpret_cast<const void*>(address));
+  if (!module) {
+    return fmt::format("0x{:X}", address);
+  }
+  static const auto get_module_file_name =
+      GetSystemProc<GetModuleFileNameWFn>("GetModuleFileNameW");
+  std::string name = "module";
+  if (get_module_file_name) {
+    wchar_t buffer[MAX_PATH];
+    DWORD length = get_module_file_name(module, buffer, MAX_PATH);
+    if (length && length < MAX_PATH) {
+      std::wstring wide(buffer, length);
+      size_t slash = wide.find_last_of(L"\\/");
+      if (slash != std::wstring::npos) {
+        wide = wide.substr(slash + 1);
+      }
+      name.clear();
+      for (wchar_t c : wide) {
+        name.push_back(c < 0x80 ? char(c) : '?');
+      }
+    }
+  }
+  return fmt::format("{}+0x{:X}", name,
+                     address - reinterpret_cast<uint64_t>(module));
+}
+
+bool IsReadable(uint64_t address, size_t size) {
+  MEMORY_BASIC_INFORMATION info = {};
+  if (!VirtualQuery(reinterpret_cast<const void*>(address), &info,
+                    sizeof(info))) {
+    return false;
+  }
+  if (info.State != MEM_COMMIT ||
+      (info.Protect & (PAGE_NOACCESS | PAGE_GUARD))) {
+    return false;
+  }
+  uint64_t region_end =
+      reinterpret_cast<uint64_t>(info.BaseAddress) + info.RegionSize;
+  return address + size <= region_end;
+}
+
+// Logs the call stack of the crashed thread, unwinding from its context.
+void LogStack(const CONTEXT* crash_context) {
+  static const auto lookup =
+      GetSystemProc<RtlLookupFunctionEntryFn>("RtlLookupFunctionEntry");
+  static const auto unwind =
+      GetSystemProc<RtlVirtualUnwindFn>("RtlVirtualUnwind");
+  if (!crash_context) {
+    return;
+  }
+  CONTEXT context = *crash_context;
+  CrashLogLine("CRASH: call stack (most recent first):");
+  for (int frame = 0; frame < 48; ++frame) {
+    uint64_t pc = context.Rip;
+    if (!pc) {
+      break;
+    }
+    CrashLogLine(fmt::format("CRASH:   #{:02} {}", frame, DescribeAddress(pc)));
+    if (!lookup || !unwind) {
+      break;
+    }
+    DWORD64 image_base = 0;
+    void* function_entry = lookup(pc, &image_base, nullptr);
+    if (function_entry) {
+      PVOID handler_data = nullptr;
+      DWORD64 establisher_frame = 0;
+      unwind(0 /* UNW_FLAG_NHANDLER */, image_base, pc, function_entry,
+             &context, &handler_data, &establisher_frame, nullptr);
+    } else {
+      // Leaf function: the return address is at the top of the stack.
+      if (!IsReadable(context.Rsp, sizeof(uint64_t))) {
+        break;
+      }
+      context.Rip = *reinterpret_cast<const uint64_t*>(context.Rsp);
+      context.Rsp += sizeof(uint64_t);
+    }
+  }
+}
+
+LONG WINAPI CrashFilter(EXCEPTION_POINTERS* info) {
+  if (!crash_logged_.exchange(true) && info && info->ExceptionRecord) {
+    const EXCEPTION_RECORD* record = info->ExceptionRecord;
+    CrashLogLine(fmt::format(
+        "CRASH: unhandled exception 0x{:08X} at {} on thread {}",
+        uint32_t(record->ExceptionCode),
+        DescribeAddress(reinterpret_cast<uint64_t>(record->ExceptionAddress)),
+        GetCurrentThreadId()));
+    if (record->ExceptionCode == EXCEPTION_ACCESS_VIOLATION &&
+        record->NumberParameters >= 2) {
+      const char* kind = record->ExceptionInformation[0] == 0   ? "reading"
+                         : record->ExceptionInformation[0] == 1 ? "writing"
+                                                                : "executing";
+      CrashLogLine(fmt::format("CRASH: access violation {} address 0x{:X}",
+                               kind, record->ExceptionInformation[1]));
+    }
+    LogStack(info->ContextRecord);
+  }
+  return previous_filter_ ? previous_filter_(info) : EXCEPTION_CONTINUE_SEARCH;
+}
+
+void InvalidParameterHandler(const wchar_t* expression,
+                             const wchar_t* function, const wchar_t* file,
+                             unsigned int line, uintptr_t) {
+  auto narrow = [](const wchar_t* text) {
+    std::string result;
+    for (; text && *text; ++text) {
+      result.push_back(*text < 0x80 ? char(*text) : '?');
+    }
+    return result;
+  };
+  CrashLogLine(fmt::format(
+      "CRASH: C runtime invalid parameter: {} in {} ({}:{})",
+      narrow(expression), narrow(function), narrow(file), line));
+}
+
+}  // namespace
+
+void InstallCrashLogging() {
+  static bool installed = false;
+  if (installed) {
+    return;
+  }
+  installed = true;
+  if (auto set_filter = GetSystemProc<SetUnhandledExceptionFilterFn>(
+          "SetUnhandledExceptionFilter")) {
+    previous_filter_ = set_filter(CrashFilter);
+  }
+  std::set_terminate([] {
+    std::string what = "no active exception";
+    if (std::exception_ptr exception = std::current_exception()) {
+      try {
+        std::rethrow_exception(exception);
+      } catch (const std::exception& e) {
+        what = e.what();
+      } catch (...) {
+        what = "a non-standard C++ exception";
+      }
+    }
+    CrashLogLine("CRASH: std::terminate called (" + what + ")");
+    std::abort();
+  });
+  _set_invalid_parameter_handler(InvalidParameterHandler);
+}
+
 }  // namespace rex::platform::uwp
 
 #endif  // REX_PLATFORM_WINRT
